class Book:
    def __init__(self, book_id, title, author):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.borrowed_by = None

    def is_available(self):
        return self.borrowed_by is None


class Member:
    def __init__(self, member_id, name):
        self.member_id = member_id
        self.name = name
        self.borrowed_books = []


class Library:
    def __init__(self):
        self.books = {}
        self.members = {}

    def add_book(self, book_id, title, author):
        if book_id in self.books:
            print("A book with this ID already exists.")
            return

        self.books[book_id] = Book(book_id, title, author)
        print("Book added successfully.")

    def register_member(self, member_id, name):
        if member_id in self.members:
            print("A member with this ID already exists.")
            return

        self.members[member_id] = Member(member_id, name)
        print("Member registered successfully.")

    def view_books(self):
        if not self.books:
            print("No books in the library.")
            return

        for book in self.books.values():
            status = "Available" if book.is_available() else "Borrowed"
            print(
                f"ID: {book.book_id} | Title: {book.title} | "
                f"Author: {book.author} | Status: {status}"
            )

    def search_book(self, title):
        matches = [
            book for book in self.books.values()
            if title.lower() in book.title.lower()
        ]

        if not matches:
            print("No matching books found.")
            return

        for book in matches:
            status = "Available" if book.is_available() else "Borrowed"
            print(f"ID: {book.book_id} | {book.title} by {book.author} | {status}")

    def borrow_book(self, member_id, book_id):
        member = self.members.get(member_id)
        book = self.books.get(book_id)

        if member is None:
            print("Member not found.")
        elif book is None:
            print("Book not found.")
        elif not book.is_available():
            print("This book is already borrowed.")
        else:
            book.borrowed_by = member_id
            member.borrowed_books.append(book_id)
            print(f"{member.name} borrowed '{book.title}' successfully.")

    def return_book(self, member_id, book_id):
        member = self.members.get(member_id)
        book = self.books.get(book_id)

        if member is None:
            print("Member not found.")
        elif book is None:
            print("Book not found.")
        elif book.borrowed_by != member_id:
            print("This member has not borrowed this book.")
        else:
            book.borrowed_by = None
            member.borrowed_books.remove(book_id)
            print(f"'{book.title}' returned successfully.")

    def view_member_books(self, member_id):
        member = self.members.get(member_id)

        if member is None:
            print("Member not found.")
        elif not member.borrowed_books:
            print(f"{member.name} has not borrowed any books.")
        else:
            print(f"Books borrowed by {member.name}:")
            for book_id in member.borrowed_books:
                book = self.books[book_id]
                print(f"- {book.title} by {book.author} (ID: {book_id})")


def get_required_input(prompt):
    while True:
        value = input(prompt).strip()
        if value:
            return value
        print("This field cannot be empty.")


def main():
    library = Library()

    while True:
        print("\n===== LIBRARY MANAGEMENT SYSTEM =====")
        print("1. Add book")
        print("2. Register member")
        print("3. View all books")
        print("4. Search book by title")
        print("5. Borrow book")
        print("6. Return book")
        print("7. View member's borrowed books")
        print("8. Exit")

        choice = input("Enter your choice (1-8): ").strip()

        if choice == "1":
            book_id = get_required_input("Enter book ID: ")
            title = get_required_input("Enter title: ")
            author = get_required_input("Enter author: ")
            library.add_book(book_id, title, author)

        elif choice == "2":
            member_id = get_required_input("Enter member ID: ")
            name = get_required_input("Enter member name: ")
            library.register_member(member_id, name)

        elif choice == "3":
            library.view_books()

        elif choice == "4":
            title = get_required_input("Enter title to search: ")
            library.search_book(title)

        elif choice == "5":
            member_id = get_required_input("Enter member ID: ")
            book_id = get_required_input("Enter book ID: ")
            library.borrow_book(member_id, book_id)

        elif choice == "6":
            member_id = get_required_input("Enter member ID: ")
            book_id = get_required_input("Enter book ID: ")
            library.return_book(member_id, book_id)

        elif choice == "7":
            member_id = get_required_input("Enter member ID: ")
            library.view_member_books(member_id)

        elif choice == "8":
            print("Thank you for using the Library Management System!")
            break

        else:
            print("Invalid choice. Enter a number from 1 to 8.")


if __name__ == "__main__":
    main()
