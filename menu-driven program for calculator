from for_loop_numbers import print_numbers_for
from while_loop_numbers import print_numbers_while
from sum_of_n import sum_of_n
from multiplication_table import multiplication_table
from factorial_loop import factorial_loop
from reverse_number_loop import reverse_number_loop
from even_odd import even_odd
from star_pattern import star_pattern


def menu():
    while True:
        print("\n===== MENU =====")
        print("1. Print Numbers (for loop)")
        print("2. Print Numbers (while loop)")
        print("3. Sum of First N Numbers")
        print("4. Multiplication Table")
        print("5. Factorial")
        print("6. Reverse a Number")
        print("7. Even and Odd Numbers")
        print("8. Star Pattern")
        print("0. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            n = int(input("Enter a number: "))
            print_numbers_for(n)

        elif choice == "2":
            n = int(input("Enter a number: "))
            print_numbers_while(n)

        elif choice == "3":
            n = int(input("Enter a number: "))
            print("Sum:", sum_of_n(n))

        elif choice == "4":
            n = int(input("Enter a number: "))
            multiplication_table(n)

        elif choice == "5":
            n = int(input("Enter a number: "))
            print("Factorial:", factorial_loop(n))

        elif choice == "6":
            n = int(input("Enter a number: "))
            print("Reversed Number:", reverse_number_loop(n))

        elif choice == "7":
            n = int(input("Enter a number: "))
            evens, odds = even_odd(n)
            print("Evens:", evens)
            print("Odds:", odds)

        elif choice == "8":
            n = int(input("Enter a number: "))
            star_pattern(n)

        elif choice == "0":
            print("Exiting...")
            break

        else:
            print("Invalid choice. Try again.")


if __name__ == "__main__":
    menu()
